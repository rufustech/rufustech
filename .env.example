# Copy to .env and fill in real values. Do NOT commit .env.

# Gmail account used to send mail (SMTP auth identity)
GMAIL_USER=you@gmail.com

# Gmail App Password (16 chars, no spaces) — requires 2FA on the account.
# Generate/revoke at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Inbox that receives contact-form submissions
CONTACT_TO=you@gmail.com

# Friendly From name shown in the inbox
MAIL_FROM_NAME=RufaroDev Website

# Port for the API server
PORT=5001

# Comma-separated origins allowed to POST the form
ALLOWED_ORIGINS=http://localhost:3000,https://rufarodev.com
